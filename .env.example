# ---- Core (required in production) ----
# Public HTTPS URL of this app, no trailing slash. OAuth callbacks are ${APP_URL}/api/oauth/<provider>/callback
APP_URL=http://localhost:3000
# 32 random bytes, base64. Generate: openssl rand -base64 32   (encrypts OAuth tokens at rest)
ENCRYPTION_KEY=
# Protects GET/POST /api/cron/publish (send "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ---- Access ----
# false = nobody new can sign up (existing users still log in). Set after creating your account.
SIGNUP_ENABLED=true
# Optional comma-separated allowlist; when set, only these emails can sign up or log in.
ALLOWED_EMAILS=

# ---- Storage ----
# Defaults: ./data/app.db and ./data/uploads (or $RAILWAY_VOLUME_MOUNT_PATH/... on Railway)
DATABASE_PATH=
UPLOADS_DIR=
# Where platforms download media from. Defaults to APP_URL. Must be public for Instagram/TikTok.
PUBLIC_MEDIA_BASE_URL=
MAX_UPLOAD_MB=200

# ---- Scheduler ----
# Run the publishing loop inside the web server (use on Railway / single-server hosts).
RUN_WORKER_IN_PROCESS=false
WORKER_INTERVAL_MS=30000

# ---- Demo ----
# true = every provider uses simulated accounts/publishing even if keys are set
DEMO_MODE=false
DEMO_PUBLISH_DELAY_MS=800

# ---- Provider apps (one per provider, registered by the app owner) ----
# Leave a pair empty to keep that provider in demo mode.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Business-type Meta apps (Facebook Login for Business): the configuration ID to send instead of scopes
META_LOGIN_CONFIG_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
# true = also request company-page scopes (needs Community Management API approval)
LINKEDIN_ORG_POSTING=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# FILE_UPLOAD (default) or PULL_FROM_URL (only after verifying your domain with TikTok)
TIKTOK_VIDEO_SOURCE=FILE_UPLOAD
